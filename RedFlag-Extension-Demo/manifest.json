{
  "manifest_version": 3,
  "name": "RedFlag — Misinformation Alert Demo",
  "version": "1.0.0",
  "description": "Flags potentially misleading claims on webpages and explains why they need verification.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5000/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RedFlag",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
